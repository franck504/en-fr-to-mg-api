APP_NAME=en-fr-to-mg-service
APP_ENV=colab
HOST=0.0.0.0
PORT=8000

# API Key Authentication (Configure strictly via Secret, no auto-generation)
API_KEY=your_secret_api_key_here

# Default Provider (hf_seq2seq or gemma4)
PROVIDER=hf_seq2seq

# Hugging Face Seq2Seq Configuration (NLLB / M2M100)
HF_MODEL_NAME=facebook/nllb-200-distilled-1.3B
HF_MODEL_FAMILY=nllb
HF_DEVICE=auto

# Gemma 4 Configuration
GEMMA4_MODEL_NAME=google/gemma-4-E2B-it
GEMMA4_DEVICE=auto
GEMMA4_MAX_NEW_TOKENS=256

# Translation Parameters
SOURCE_LANGUAGE_DEFAULT=auto
TARGET_LANGUAGE=mg
TRANSLATION_MAX_LENGTH=256

# Cache and Startup
MODEL_CACHE_DIR=/content/hf_models
LOAD_MODEL_ON_STARTUP=true

# Exposure via ngrok (Colab / Kaggle)
ENABLE_NGROK=true
NGROK_AUTHTOKEN=replace_me

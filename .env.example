APP_NAME=en-fr-to-mg-service
APP_ENV=development
HOST=0.0.0.0
PORT=8000

# Default Provider (hf_seq2seq or gemma4)
PROVIDER=hf_seq2seq

# Hugging Face Seq2Seq Configuration (NLLB / M2M100)
HF_MODEL_NAME=facebook/nllb-200-distilled-600M
HF_MODEL_FAMILY=auto
HF_DEVICE=auto

# Gemma 4 Configuration
GEMMA4_MODEL_NAME=google/gemma-4-E2B-it
GEMMA4_DEVICE=auto
GEMMA4_MAX_NEW_TOKENS=256

# Translation Parameters
SOURCE_LANGUAGE_DEFAULT=auto
TARGET_LANGUAGE=mg
TRANSLATION_MAX_LENGTH=256

# Cache and Startup
MODEL_CACHE_DIR=/content/hf_models
LOAD_MODEL_ON_STARTUP=false
